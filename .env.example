BACKEND_PORT=
FRONTEND_PORT=

# mediamtx → 이 모듈 compose 의 bundled 인스턴스.
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_API_PORT=10005
MEDIAMTX_RTSP_PORT=8562
MEDIAMTX_WEBRTC_PORT=8897
MEDIAMTX_ICE_UDP_PORT=8197
MEDIAMTX_WEBRTC_HOST=
MEDIAMTX_BACKEND_PASS=
MEDIAMTX_VIEWER_USER=viewer_rtsp_detection
MEDIAMTX_VIEWER_PASS=

# detection (YOLO 추론). YOLO_DEVICE 빈값 = GPU 자동감지, 없으면 CPU 폴백.
YOLO_DEFAULT_MODEL=yolo26n.pt
YOLO_CONF_THRESHOLD=0.5
YOLO_DEVICE=
